{
  "name": "outcomes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "From a gift to a delivered outcome, reported back to the donor. A fulfilment and donor-feedback system for charities.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "feed:from-exports": "node scripts/export-to-feed.ts",
    "db:init": "node --env-file=.env.local scripts/db-init.mjs",
    "db:reset-records": "node --env-file=.env.local scripts/db-reset-records.mjs",
    "a11y": "node scripts/a11y.mjs"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.23",
    "@types/node": "^26.6.6",
    "axe-core": "^4.14.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "leaflet": "^1.9.4"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "charity",
    "fulfilment",
    "donor-feedback",
    "nonprofit",
    "crm",
    "accessibility"
  ]
}
